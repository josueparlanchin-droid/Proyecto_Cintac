# ==================================================================
# Variables de entorno del backend - CINTAC Cotizador Comex
# ==================================================================
# Copia este archivo como `.env` y ajusta los valores.
#   .env.example  ->  .env
#
# El `.env` contiene la contraseña de la base y NO debe subirse al
# repositorio: ya está en `.gitignore`.
# ==================================================================

# --- Servidor -----------------------------------------------------
PORT=4010
NODE_ENV=development

# --- Base de datos (PostgreSQL) ------------------------------------
# Cadena de conexión entregada por el proveedor (Neon / Render / local).
#
# En Neon, usa la URL con sufijo `-pooler` para producción: enruta por el
# pooler de PgBouncer y aguanta muchas conexiones concurrentes.
#
# `sslmode=verify-full` es la forma explícita y recomendada: `pg` trata
# `require` como alias de `verify-full` y avisa por consola. Neon usa un
# certificado de CA pública, así que la validación completa funciona sin
# relajar nada. No uses `sslmode=no-verify`: viajaría sin cifrar.
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=verify-full

# --- Autenticacion ------------------------------------------------
# OBLIGATORIA en produccion: si se deja el valor por defecto, el proceso
# se detiene al arrancar (el valor de desarrollo es público).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cintac-comex-desarrollo-clave-temporal
JWT_EXPIRES_IN=8h

# --- CORS ---------------------------------------------------------
# Origen(es) permitido(s), separados por coma. En produccion debe ser el
# dominio de Vercel, no `*`: el backend usa `credentials: true`.
CORS_ORIGIN=http://localhost:5173

# --- Limites de peticiones ----------------------------------------
# Limite GLOBAL de la API: red de seguridad para trafico automatizado.
# Holgado a proposito, no es un contador de uso normal.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MIN=15

# Limite de intentos FALLIDOS de login, por cuenta (y por IP cuando el
# correo no existe). Solo cuenta los fallos: un login correcto nunca
# agota el cupo.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MIN=15

# --- Carga de planillas ------------------------------------------
UPLOAD_MAX_MB=5
