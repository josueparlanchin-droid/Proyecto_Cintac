# Configuracion del frontend (Vite).
#
# Copiar a .env solo si se necesita un valor local. NO es necesario para
# desarrollo: sin VITE_API_URL la app llama a /api/v1 sobre el mismo origen y
# el proxy de vite.config.js la reenvia a http://localhost:4010.

# URL publica de la API. OBLIGATORIA en Vercel, para Production y Preview.
#
# Sin esta variable el despliegue consulta /api/v1 contra el propio dominio de
# Vercel, que no sirve la API: responde con el index.html de la SPA y el login
# falla al intentar parsear ese HTML como JSON.
#
# Debe incluir el prefijo /api/v1 y terminar sin barra final.
VITE_API_URL=https://proyecto-cintac.onrender.com/api/v1
